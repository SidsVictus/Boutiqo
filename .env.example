# Copy to .env.local for local development. Never commit real values.

# --- Supabase ---------------------------------------------------------------
# Project URL and keys, from Supabase project settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. NEVER prefix with NEXT_PUBLIC_, never send to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Cloudflare R2 (server-only; never NEXT_PUBLIC_) ------------------------
# R2 dashboard > Manage R2 API Tokens.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=boutiqo-uploads
# Optional: override the S3-compatible endpoint (defaults to the standard R2 endpoint
# derived from R2_ACCOUNT_ID). Used in tests to point at a local S3-compatible mock
# (e.g. `npx s3rver`, which only accepts its built-in S3RVER/S3RVER credentials —
# see tests/r2/r2.test.ts for a self-contained example).
R2_ENDPOINT=

# --- App ---------------------------------------------------------------------
# The app itself builds tracking links and OAuth redirects from
# window.location.origin at runtime, not from this var — it isn't read
# anywhere in src/. Kept here as the documented origin value to paste into
# R2's CORS allow-list and Supabase Auth's redirect allow-list when
# configuring those from their dashboards (see README).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Live E2E tests (tests/e2e/*.spec.ts), optional -------------------------
# Only needed to run `RUN_LIVE_E2E=1 npx playwright test` against a real
# Supabase project with seeded dev accounts (see docs/phase1-report.md §12).
# Never real/production credentials.
# RUN_LIVE_E2E=1
# TEST_OWNER_EMAIL=owner1@boutiqo.dev
# TEST_OWNER_PASSWORD=
# TEST_ADMIN_EMAIL=admin.owner@boutiqo.dev
# TEST_ADMIN_PASSWORD=
# TEST_TRACKING_TOKEN=
# TEST_ORDER_CODE=
