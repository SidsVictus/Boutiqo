# Copy to .env.local for local development. Never commit real values.

# --- Supabase ---------------------------------------------------------------
# Project URL and keys, from Supabase project settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. NEVER prefix with NEXT_PUBLIC_, never send to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Cloudflare R2 (server-only; never NEXT_PUBLIC_) ------------------------
# R2 dashboard > Manage R2 API Tokens.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=boutiqo-uploads
# Optional: override the S3-compatible endpoint (defaults to the standard R2 endpoint
# derived from R2_ACCOUNT_ID). Used in tests to point at a local S3-compatible mock
# (e.g. `npx s3rver`, which only accepts its built-in S3RVER/S3RVER credentials —
# see tests/r2/r2.test.ts for a self-contained example).
R2_ENDPOINT=

# --- App ---------------------------------------------------------------------
# Origin used to build tracking links and to configure R2/Supabase CORS allow-lists.
NEXT_PUBLIC_APP_URL=http://localhost:3000
