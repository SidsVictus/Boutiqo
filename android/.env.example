# Copy to .env.local for local development (gitignored).
# EVERYTHING prefixed EXPO_PUBLIC_ is bundled into the APK and is public.
# Never put Supabase service-role keys, R2 keys or any other secret here —
# the shell doesn't need them: the web app it loads talks to its own backend.

# Web app the shell loads. Omit to use production (https://boutiqoo.netlify.app).
# For a local Next.js server, use your computer's LAN IP (not localhost —
# on the phone, localhost is the phone). http:// only works in development.
# EXPO_PUBLIC_WEB_APP_URL=http://192.168.1.20:3000
